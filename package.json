{
  "name": "slideck-html",
  "version": "2.2.1",
  "description": "Stable single-file HTML slide decks: frozen 1920x1080 shell, 19 designs, 10 themes with embedded fonts, placeholder layouts, SVG charts, concept diagrams, icons, Mermaid, PPTX import/export, PDF export, custom designs. Zero dependency.",
  "keywords": [
    "slides",
    "slide-deck",
    "presentation",
    "html",
    "pdf",
    "pptx",
    "powerpoint",
    "charts",
    "mermaid",
    "claude-code"
  ],
  "homepage": "https://slideck.nimb.us.ci/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdyarief/slideck-html.git"
  },
  "bugs": "https://github.com/mahdyarief/slideck-html/issues",
  "license": "MIT",
  "author": "mahdyarief",
  "bin": {
    "slideck": "bin/slideck.js",
    "slideck-html": "bin/slideck.js"
  },
  "files": [
    "bin/",
    "lib/",
    "layouts/",
    "designs/",
    "themes/",
    "motions/",
    "templates/",
    "assets/",
    "docs/",
    "skills/",
    "slides/",
    "template.html",
    "core.css",
    "build.js",
    "pdf.js",
    "pptx.js",
    "import.js",
    "check.js",
    "deck.json",
    "FROZEN.json",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "pdf": "node pdf.js",
    "check": "node check.js",
    "lint": "node bin/slideck.js lint --all",
    "examples": "node examples/build-all.js && node check.js --examples",
    "lock": "node build.js --lock",
    "prepublishOnly": "node bin/slideck.js lint --all && node build.js && node examples/build-all.js"
  }
}
